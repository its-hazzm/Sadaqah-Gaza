{
  "expo": {
    "name": "صدقة - Gaza",
    "slug": "amir-nofal-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#071a0b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amirnofal.azkar"
    },
    "android": {
      "package": "com.amirnofal.azkar",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071a0b"
      },
      "largeHeap": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "owner": "hazm-nofal",
    "extra": {
      "eas": {
        "projectId": "8004aa18-1648-4441-9d1e-913b6113e309"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c9a84c",
          "sounds": [
            "./assets/sounds/takbeer.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/Sadaqah-Gaza"
    }
  }
}